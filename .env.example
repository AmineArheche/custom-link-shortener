# AuraLink Environment Configuration

APP_NAME="AuraLink - Custom Link Shortener & Analytics"
BASE_URL="http://localhost:8000"

# Default to SQLite (zero-config). For PostgreSQL, use: postgresql://user:password@localhost:5432/auralink
DATABASE_URL="sqlite:///./link_shortener.db"

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Short Code Length
SHORT_CODE_LENGTH=6
